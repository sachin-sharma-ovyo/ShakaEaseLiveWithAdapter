new file mode 100644
index 0000000000000000000000000000000000000000..a93c59866c10516c697a3c6bae5cc4a57eb62dff
--- /dev/null
+++ b/web/tests/ad-resume.cjs
@@ -0,0 +1,59 @@
+// SDK simulation: node web/tests/ad-resume.cjs
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const ts = require('../node_modules/typescript');
+const previous = require.extensions['.ts'];
+require.extensions['.ts'] = (module, filename) => module._compile(ts.transpileModule(
+  fs.readFileSync(filename, 'utf8'),
+  { compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2020 } },
+).outputText, filename);
+const { AdController } = require('../src/ads/AdController.ts');
+require.extensions['.ts'] = previous;
+
+async function run() {
+  global.window = { setTimeout, clearTimeout, google: { ima: { AdsLoader: class {} } } };
+  global.google = { ima: { AdsRequest: class { setAdWillAutoPlay() {} setAdWillPlayMuted() {} } } };
+  for (const ending of ['ad-stopped', 'ad-error', 'destroy']) {
+    const manager = new EventTarget();
+    let requests = 0, pauses = 0, resumes = 0;
+    manager.initClientSide = () => {};
+    manager.requestClientSideAds = () => requests++;
+    const controller = new AdController({ getAdManager: () => manager, configure() {} }, [], 100);
+    const states = [];
+    controller.onChange(state => states.push(state));
+    const ima = { pause() { pauses++; }, resume() { resumes++; }, stop() {} };
+    assert.equal(controller.tryInit({}, {}), true);
+    const done = controller.playBreak({ id: 'pre', kind: 'pre', offsetSec: 0, tagUrl: 'https://example.test/ad' });
+    const loaded = new Event('ima-ad-manager-loaded');
+    loaded.imaAdManager = ima;
+    manager.dispatchEvent(loaded);
+    controller.setAdPaused(false);
+    assert.equal(resumes, 0, 'ignore transport during loading');
+    manager.dispatchEvent(new Event('ad-started'));
+    manager.dispatchEvent(new Event('ad-paused')); // Click-through pauses externally.
+    assert.deepEqual(states.at(-1), { active: true, phase: 'paused' });
+    assert.equal(controller.isAdPlaying, true, 'paused ad keeps content locked');
+    controller.setAdPaused(false);
+    assert.equal(resumes, 1);
+    assert.equal(states.at(-1).phase, 'paused', 'wait for observed SDK state');
+    manager.dispatchEvent(new Event('ad-resumed'));
+    assert.equal(states.at(-1).phase, 'playing');
+    controller.setAdPaused(true);
+    assert.equal(pauses, 1);
+    assert.equal(requests, 1, 'no new request or restart');
+    if (ending === 'destroy') controller.destroy();
+    else manager.dispatchEvent(new Event(ending));
+    await done;
+    assert.equal(controller.isAdPlaying, false);
+    if (ending !== 'destroy') assert.equal(states.at(-1).active, false);
+    controller.setAdPaused(false);
+    assert.equal(resumes, 1, 'completed ad cannot resume');
+    controller.destroy();
+    const count = states.length;
+    manager.dispatchEvent(new Event('ad-paused'));
+    manager.dispatchEvent(new Event('ad-resumed'));
+    assert.equal(states.length, count, 'listeners removed on teardown');
+  }
+  console.log('PASS: pause/resume, no restart, locks, completion/error, repeated creation and teardown');
+}
+run().catch(error => { console.error(error); process.exitCode = 1; });
