diff --git a/web/src/ads/AdPlaybackControl.ts b/web/src/ads/AdPlaybackControl.ts
new file mode 100644
index 0000000000000000000000000000000000000000..73e41310dc8fb477c8a84d2b55cbb67e6de5b842
--- /dev/null
+++ b/web/src/ads/AdPlaybackControl.ts
@@ -0,0 +1,49 @@
+import { createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { PlayPause } from '@white-label/ui-react';
+import type { AdBreakState } from './AdvertisingState';
+import './AdPlaybackControl.css';
+
+/** Ad transport lives inside IMA's surface, exempt from the content keyboard lock. */
+export class AdPlaybackControl {
+  private readonly element: HTMLDivElement;
+  private readonly root: Root;
+  private state: AdBreakState = { active: false, phase: 'loading' };
+  private destroyed = false;
+
+  constructor(private readonly container: HTMLElement, private readonly setPaused: (paused: boolean) => void) {
+    this.element = document.createElement('div');
+    this.element.className = 'wlp-ad-playback-control';
+    this.element.hidden = true;
+    container.appendChild(this.element);
+    this.root = createRoot(this.element);
+  }
+
+  update(state: AdBreakState): void {
+    if (this.destroyed) return;
+    this.state = state;
+    // Shaka can clear the surface while unloading previous content.
+    if (state.active && this.element.parentElement !== this.container) {
+      this.container.appendChild(this.element);
+    }
+    this.element.hidden = !state.active || state.phase === 'loading';
+    this.root.render(createElement(PlayPause, {
+      size: 'sm',
+      isPlaying: state.phase === 'playing',
+      label: state.phase === 'paused' ? 'Resume advertisement' : 'Pause advertisement',
+      onClick: (event) => {
+        event.stopPropagation();
+        if (!this.destroyed && this.state.active && this.state.phase !== 'loading') {
+          this.setPaused(this.state.phase === 'playing');
+        }
+      },
+    }));
+  }
+
+  destroy(): void {
+    if (this.destroyed) return;
+    this.destroyed = true;
+    this.root.unmount();
+    this.element.remove();
+  }
+}
