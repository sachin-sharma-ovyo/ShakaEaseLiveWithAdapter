+++ b/web/tests/autoplay.cjs
@@ -0,0 +1,83 @@
+// Focused startup simulation: node web/tests/autoplay.cjs
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const ts = require('../node_modules/typescript');
+const previous = require.extensions['.ts'];
+require.extensions['.ts'] = (module, filename) => module._compile(ts.transpileModule(
+  fs.readFileSync(filename, 'utf8'),
+  { compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2020 } },
+).outputText, filename);
+const { ContentPlaybackSession } = require('../src/player/ContentPlaybackSession.ts');
+const { AdController } = require('../src/ads/AdController.ts');
+const Module = require('node:module');
+const originalLoad = Module._load;
+let sdkConfig;
+Module._load = function(name, ...args) {
+  if (name === 'bitmovin-player') return {
+    Player: class { constructor(container, config) { sdkConfig = config; } on() {} },
+    PlayerEvent: {},
+  };
+  return originalLoad.call(this, name, ...args);
+};
+const { BitmovinPlayer } = require('../src/bitmovin/BitmovinPlayer.ts');
+Module._load = originalLoad;
+require.extensions['.ts'] = previous;
+
+async function run() {
+  global.window = { setTimeout, clearTimeout, google: { ima: { AdsLoader: class {} } } };
+  global.KeyboardEvent = class {};
+  for (const autoplay of [false, true]) {
+    const calls = [];
+    const ads = {
+      isAdPlaying: false,
+      initialize(auto = false) { calls.push(['init', auto]); return true; },
+      async playPrerolls() { calls.push('ads'); },
+      resumeContent() { calls.push('resume-content'); },
+      destroy() { calls.push('destroy'); },
+    };
+    const session = new ContentPlaybackSession({}, async () => { calls.push('play'); }, ads);
+    const pending = session.start({ autoplay, load: async () => { calls.push('load'); },
+      onWaiting() { calls.push('waiting'); }, onLoading() {} });
+    if (!autoplay) {
+      assert.deepEqual(calls, ['waiting'], 'false must not initialize, request or load ads');
+      assert(session.beginFromGesture());
+    }
+    await pending;
+    assert.deepEqual(calls.filter(Array.isArray), [['init', autoplay]]);
+    assert(calls.indexOf('ads') < calls.indexOf('load'));
+    assert(calls.indexOf('load') < calls.indexOf('play'));
+    session.dispose();
+  }
+  let plays = 0;
+  const cancelled = new ContentPlaybackSession({}, async () => { plays++; }, {
+    initialize: () => true, destroy() {}, isAdPlaying: false,
+  });
+  const waiting = cancelled.start({ autoplay: false, load: async () => {}, onWaiting() {}, onLoading() {} });
+  cancelled.dispose(); await waiting;
+  assert.equal(plays, 0, 'disposal while awaiting Play must cancel startup');
+
+  for (const autoplay of [true, false]) {
+    new BitmovinPlayer({}, { licenseKey: 'simulation', autoplay });
+    assert.equal(sdkConfig.playback.autoplay, autoplay);
+    assert.equal(sdkConfig.playback.muted, false, 'autoplay must not implicitly mute audio');
+  }
+  new BitmovinPlayer({}, { licenseKey: 'simulation', autoplay: true, muted: true });
+  assert.equal(sdkConfig.playback.muted, true, 'explicit mute is honored');
+
+  let request;
+  global.google = { ima: { AdsRequest: class {
+    setAdWillAutoPlay(value) { this.autoplay = value; }
+    setAdWillPlayMuted(value) { this.muted = value; }
+  } } };
+  const manager = new EventTarget();
+  manager.initClientSide = () => {};
+  manager.requestClientSideAds = value => { request = value; };
+  const controller = new AdController({ getAdManager: () => manager, configure() {} }, [], 100);
+  controller.tryInit({}, { muted: true, volume: 1 }, true);
+  const pending = controller.playBreak({ id: 'pre', kind: 'pre', offsetSec: 0, tagUrl: 'https://example.test/ad' });
+  assert.equal(request.autoplay, true);
+  assert.equal(request.muted, true);
+  controller.destroy(); await pending;
+  console.log('PASS: true/false startup, preroll order, cancellation, IMA flags and Bitmovin SDK config');
+}
+run().catch(error => { console.error(error); process.exitCode = 1; });
